# ---- Obligatorias -----------------------------------------------------------
# Contraseña para entrar al panel (/login). Usa una larga: quien la tenga puede cambiar el sitio.
ADMIN_PASSWORD=
# Cadena aleatoria larga que firma la sesión (openssl rand -hex 32). No la compartas.
ADMIN_SESSION_SECRET=

# ---- Almacenamiento (contenido editado y fotos subidas) ---------------------
# En Railway no hace falta: se usa solo el volumen montado (RAILWAY_VOLUME_MOUNT_PATH).
# En tu computador, por defecto es ./data. Cámbialo solo si quieres otra carpeta.
# DATA_DIR=/data

# ---- Opcionales: administrar también las entradas de Blogger ---------------
# URL pública de esta app (para la redirect URI de OAuth)
APP_URL=http://localhost:3000
# Google Cloud: OAuth client "Web application" con Blogger API v3 activada.
# Redirect URI autorizada: ${APP_URL}/api/blogger/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Se obtiene desde /connect tras autorizar con la cuenta dueña del blog
BLOGGER_REFRESH_TOKEN=
BLOGGER_BLOG_URL=https://creactivosaudiovisual.blogspot.com/
BLOGGER_BLOG_ID=
