# ---- Obligatorias -----------------------------------------------------------
# Contraseña para entrar al panel (/login). Usa una larga: quien la tenga puede cambiar el sitio.
ADMIN_PASSWORD=
# Cadena aleatoria larga que firma la sesión (openssl rand -hex 32). No la compartas.
ADMIN_SESSION_SECRET=

# ---- Almacenamiento (contenido editado y fotos subidas) ---------------------
# En Railway no hace falta: se usa solo el volumen montado (RAILWAY_VOLUME_MOUNT_PATH).
# En tu computador, por defecto es ./data. Cámbialo solo si quieres otra carpeta.
# DATA_DIR=/data
